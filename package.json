{
  "name": "argus",
  "private": true,
  "type": "module",
  "description": "A readable network spy for one person, live, on tshark: which devices are on the network and which companies they talk to, in plain words. Built on @organon/core.",
  "license": "MIT",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "app": "node server/control.ts",
    "start": "node server/control.ts restart --build",
    "serve": "node server/index.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node scripts/with-tmp.ts sh -c \"vite build --logLevel warn && node --test 'tests/*.test.ts'\"",
    "gates": "node scripts/with-tmp.ts sh -c 'pnpm check && pnpm check:leaks && pnpm test'",
    "check:leaks": "node scripts/check-leaks.ts",
    "release": "node scripts/release.ts",
    "tls": "bash node_modules/@organon/core/scripts/tls.sh .",
    "fixtures": "node scripts/make-fixture.ts",
    "dictionary": "node scripts/dictionary.ts",
    "geo": "node scripts/geo.ts",
    "demo": "pnpm build && node scripts/demo.ts",
    "pictures": "pnpm build && node scripts/pictures.ts"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@lucide/svelte": "1.51.0",
    "@organon/core": "https://github.com/Di0go/organon/releases/download/v0.5.1/organon-core-0.5.1.tgz"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "playwright-core": "1.58.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
